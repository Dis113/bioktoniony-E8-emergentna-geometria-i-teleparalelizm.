import Mathlib
import POM1.SpectralLink

/-!
POM-7: specific projector-overlap bridge and an obstruction to
spontaneously ordered sectors in the original POM-3 graph Hamiltonian.

The ANNNI period-four antiphase for J2>J1/2 is established
peer-reviewed physics. We do NOT claim to rediscover or prove its
general thermodynamic phase diagram.

What is original to this toy realization:
 - exact overlaps of three explicit POM-3 quaternionic sectors,
 - rewriting the binary sector overlap as an Ising pair,
 - a counterexample showing the POM-6 chosen second sector is NOT
   an energetic minimum among even two simple alternatives,
 - a conditional non-dimerization result for positive link stiffness.
-/

namespace POM1

/-- Quaternion sector C = span{1,e1,e4,e5}, generated by e4 and e5. -/
def quaternionProjectorC (i : Fin 8) : ℚ :=
  if i.val = 0 ∨ i.val = 1 ∨ i.val = 4 ∨ i.val = 5 then 1 else 0

def quaternionOverlapAC : ℚ :=
  (∑ i : Fin 8,
    quaternionProjectorA i * quaternionProjectorC i) / 4

theorem quaternionOverlapAC_half :
    quaternionOverlapAC = (1/2 : ℚ) := by
  norm_num [quaternionOverlapAC, Fin.sum_univ_succ,
    quaternionProjectorA, quaternionProjectorC]

theorem sectorC_has_less_overlap_than_B :
    quaternionOverlapAC < quaternionOverlapAB := by
  rw [quaternionOverlapAC_half, quaternionOverlapAB_five_eighths]
  norm_num

/-- A binary label is an additional reduction of the full POM-3 vacuum
    manifold; it is NOT implied by the continuous vacuum potential. -/
def sectorSign (s : Bool) : ℚ := if s then 1 else -1

def binarySectorOverlap (cross : ℚ) (a b : Bool) : ℚ :=
  if a = b then 1 else cross

/-- Translation of quaternion-projector overlap into Ising variables,
    only within a CHOSEN two-sector submanifold of the vacuum. -/
theorem binary_overlap_is_ising (cross : ℚ) (a b : Bool) :
    binarySectorOverlap cross a b =
      (1+cross)/2 + (1-cross)/2 * (sectorSign a * sectorSign b) := by
  cases a <;> cases b <;>
    simp [binarySectorOverlap, sectorSign] <;> ring

/-- The period-four AABB ring has two identical and two distinct
    nearest links, and four distinct next-nearest links. The factor
    16/3 normalizes the POM-6 overlap 5/8 to a unit Ising product. -/
noncomputable def fourCycleProjectorEnergy (cross : ℚ) : ℚ :=
  (16/3 : ℚ) * (4*cross - (2+2*cross))

theorem POM6_B_foursite_energy :
    fourCycleProjectorEnergy quaternionOverlapAB = (-4 : ℚ) := by
  rw [quaternionOverlapAB_five_eighths]
  norm_num [fourCycleProjectorEnergy]

theorem POM7_C_foursite_energy :
    fourCycleProjectorEnergy quaternionOverlapAC = (-(16/3) : ℚ) := by
  rw [quaternionOverlapAC_half]
  norm_num [fourCycleProjectorEnergy]

/-- POM-6's originally selected B is not even the minimizer
    among AABB(A,B) and AACC(A,C) trial configurations. -/
theorem POM6_B_not_minimal_for_projector_frustration :
    fourCycleProjectorEnergy quaternionOverlapAC <
      fourCycleProjectorEnergy quaternionOverlapAB := by
  rw [POM7_C_foursite_energy, POM6_B_foursite_energy]
  norm_num

/-- In the original positive-link model, zero energy excess is possible
    only if each positive-stiffness bond has zero field difference. -/
theorem positive_bond_forces_equal_fields
    (K difference onsiteExcess : ℝ)
    (hK : 0 < K) (hOnsite : 0 ≤ onsiteExcess)
    (hMin : onsiteExcess + (K/2)*difference^2 = 0) :
    difference = 0 := by
  have hk : 0 < K/2 := half_pos hK
  have hpos : 0 ≤ (K/2)*difference^2 :=
    mul_nonneg (le_of_lt hk) (sq_nonneg _)
  have hz : (K/2)*difference^2 = 0 := by linarith
  have hsq : difference^2 = 0 :=
    (mul_eq_zero.mp hz).resolve_left (ne_of_gt hk)
  nlinarith

/-- Local three-spin ANNNI energy check at J1=J2=1.
    The general period-four ground-state result is PRIOR LITERATURE. -/
def sectorSignInt (s : Bool) : ℤ := if s then 1 else -1

def periodFourLocalCertificate (a b c : Bool) : ℤ :=
  2*(sectorSignInt a)*(sectorSignInt c) -
    (sectorSignInt a)*(sectorSignInt b) -
    (sectorSignInt b)*(sectorSignInt c)

theorem periodFourLocal_lower_bound (a b c : Bool) :
    (-2 : ℤ) ≤ periodFourLocalCertificate a b c := by
  cases a <;> cases b <;> cases c <;>
    norm_num [periodFourLocalCertificate, sectorSignInt]

theorem periodFourLocal_saturation_iff_opposite (a b c : Bool) :
    periodFourLocalCertificate a b c = (-2 : ℤ) ↔ a ≠ c := by
  cases a <;> cases b <;> cases c <;>
    norm_num [periodFourLocalCertificate, sectorSignInt]

end POM1
